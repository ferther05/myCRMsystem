# GitHub contains technical sources and project skills. Project documentation,
# original reference material, and other root-level files stay local.
/*
!/.gitignore
!/.gitattributes
!/backend/
!/frontend/
!/database/
!/tools/

# Documentation formats stay local, including READMEs beside source code.
*.md
*.mdx
*.doc
*.docx
*.xls
*.xlsx
*.pdf
*.ppt
*.pptx
*.rtf

# Track the repository entry point and current progress summary.
!/README.md

# Skills include their Markdown instructions and supporting resources.
!/.agents/
/.agents/*
!/.agents/skills/
!/.agents/skills/**

# Local documentation maintenance helper
/tools/sync_api_docs.py

# Java / frontend build output
target/
node_modules/
dist/
.idea/

# Local secrets and machine settings
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
*.log
database/local-credentials.md

# Generated verification evidence and temporary browser state
output/
.playwright-cli/
__pycache__/
*.pyc
